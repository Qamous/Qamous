{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qamous-web",
  "account_id": "39292a971f28b413619657e9f2c77003",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": [
    "assets_navigation_has_no_effect"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "qamous.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "build",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": [
      "/*",
      "!/js/*",
      "!/assets/*",
      "!/public-data/*",
      "!/*.css",
      "!/*.js",
      "!/*.png",
      "!/*.jpg",
      "!/*.svg",
      "!/*.ico",
      "!/manifest.json",
      "!/robots.txt"
    ]
  },
  "services": [
    {
      "binding": "API",
      "service": "qamous-api"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "logs": {
      "invocation_logs": false
    }
  },
  "alias": {
    "qamous:ssr": "./server-build/entry.js"
  },
  "vars": {}
}
